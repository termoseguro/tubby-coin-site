# Copy to .env.local and fill in. .env* is gitignored — never commit the real one.
#
# ---- public: these ship to every visitor's browser, and that is fine ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- the project ref, used by the CLI guard in scripts/db.mjs ----
# Not a secret: it is the subdomain of the URL above. The guard compares it
# against the linked project and refuses to run if they differ, so this repo
# can never push its schema into one of your other Supabase projects.
SUPABASE_PROJECT_REF=YOUR-REF

# ---- SERVER ONLY. Never prefix these NEXT_PUBLIC_. ----
# service_role bypasses Row Level Security completely. If it leaks, rotate it
# in Project Settings -> API -> Reset service role key.
SUPABASE_SERVICE_ROLE_KEY=

# The database password you set when creating the project. Used by `db push`.
SUPABASE_DB_PASSWORD=

# A personal access token from https://supabase.com/dashboard/account/tokens
# Lets the CLI run without an interactive login.
SUPABASE_ACCESS_TOKEN=
