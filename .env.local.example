# Copy to .env.local and fill in. .env* is gitignored — never commit the real one.
#
# ---- public: these ship to every visitor's browser, and that is fine ----
# The domain this server claims to be, inside the message a wallet signs.
# MUST be pinned rather than read from the request: the app answers on every
# Vercel deployment URL too, and deriving it from the Host lets a signature
# phished under one of those names verify here. Left empty, production falls
# back to the constant in lib/server/solana.js and development uses the request
# host so localhost still works.
SITE_DOMAIN=

NEXT_PUBLIC_SUPABASE_URL=https://rkxosjkictvjgudonohu.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- the project ref ----
# OPTIONAL, and only ever a cross-check. The authority is the committed file
# supabase/ALLOWED_PROJECT_REF. If you set this and it disagrees with that file,
# every db command refuses to run rather than guessing which one you meant.
SUPABASE_PROJECT_REF=rkxosjkictvjgudonohu

# ---- SERVER ONLY. Never prefix these NEXT_PUBLIC_. ----
# service_role bypasses Row Level Security completely. If it leaks, rotate it
# in Project Settings -> API -> Reset service role key.
SUPABASE_SERVICE_ROLE_KEY=

# The database password you set when creating the project. Used by `db push`.
SUPABASE_DB_PASSWORD=

# A personal access token from https://supabase.com/dashboard/account/tokens
# Lets the CLI run without an interactive login.
SUPABASE_ACCESS_TOKEN=
